{
  "meta": {
    "name": "Fusion",
    "version": "1.0.0",
    "description": "Dual-personality theme — navy/emerald/olive in light mode, teal/pine in dark mode."
  },
  "typography": {
    "fontDisplay": "Manrope, sans-serif",
    "fontBody": "Manrope, sans-serif",
    "fontMono": "IBM Plex Mono, monospace",
    "scale": {
      "xs": 12,
      "sm": 13,
      "base": 14,
      "md": 16,
      "lg": 18,
      "xl": 21,
      "2xl": 28,
      "3xl": 36,
      "display": 44
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.6
    }
  },
  "spacing": {
    "1": 4, "2": 8, "3": 12, "4": 16, "5": 20,
    "6": 24, "8": 32, "10": 40, "12": 48, "16": 64
  },
  "radius": {
    "sm": 6,
    "md": 10,
    "lg": 14,
    "full": 999
  },
  "motion": {
    "durationFastMs": 120,
    "durationBaseMs": 150,
    "durationSlowMs": 220,
    "hoverOpacity": 0.88,
    "activeOpacity": 0.78,
    "activeScale": 0.97
  },
  "color": {
    "light": {
      "bg": "#F5F6F1",
      "surface": "#FFFFFF",
      "surface2": "#EAEBE2",
      "text": "#1B2430",
      "textMuted": "#5C6570",
      "border": "#DADCD1",
      "accent": "#1F3A5F",
      "accentText": "#FFFFFF",
      "secondary": "#1B6B4A",
      "secondaryText": "#FFFFFF",
      "tertiary": "#6E7233",
      "tertiaryText": "#FFFFFF",
      "danger": "#B3261E",
      "dangerText": "#FFFFFF"
    },
    "dark": {
      "bg": "#0B1614",
      "surface": "#12201D",
      "surface2": "#182C27",
      "text": "#E7F3EE",
      "textMuted": "#8FA89D",
      "border": "#24413A",
      "accent": "#2FBFA6",
      "accentText": "#062420",
      "secondary": "#4C9A7C",
      "secondaryText": "#0E1F17",
      "tertiary": "#E2685C",
      "tertiaryText": "#2A0B08",
      "danger": "#E2685C",
      "dangerText": "#2A0B08"
    }
  },
  "colorRoles": {
    "accent": "Primary actions, links, focus rings, chart primary series",
    "secondary": "Success states, positive deltas, confirmations",
    "tertiary": "Caution/attention states in light mode; reserved for real alerts in dark mode",
    "danger": "Errors only (failed write/sync). Extension to Fusion, added because light-mode tertiary (olive) is too mild for errors"
  }
}
